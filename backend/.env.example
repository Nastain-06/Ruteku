# Konfigurasi Database (Gunakan sqlite untuk pengujian lokal cepat tanpa docker)
DATABASE_URL=sqlite:///./ruteku.db
# Atau jika menggunakan PostgreSQL via Docker Compose:
# DATABASE_URL=postgresql+psycopg2://ruteku:ruteku@localhost:5432/ruteku

# Konfigurasi Redis (Otomatis beralih ke fakeredis jika Redis lokal belum aktif)
REDIS_URL=redis://localhost:6379/0

# Kunci Rahasia JWT Token
JWT_SECRET=GANTI_DENGAN_HASIL_PERINTAH_DI_BAWAH
# Buat secret acak:  python -c "import secrets; print(secrets.token_hex(32))"

# Konfigurasi OpenAI API (Opsional: Jika kosong, otomatis memakai algoritma fallback cerdas)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TTL Cache Harga (dalam detik, default 1800 = 30 menit sesuai NFR-17)
PRICE_TTL_SECONDS=1800

# Simulasi kegagalan penyedia harga (true untuk demo fallback harga stale)
MOCK_FAIL=false

# Konfigurasi CORS
CORS_ORIGINS=http://localhost:8000
